# Firebase project settings for online play (Firebase console → Project settings → Your apps → Web app).
# On Vercel: Project → Settings → Environment Variables (same names), then redeploy.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: App Check (reCAPTCHA Enterprise site key) — see README → "Security".
EXPO_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Local development against the Firebase emulators only (never set in production):
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1:8080
